{
  "name": "innosage-ai-recorder",
  "version": "0.1.9",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test:transcript": "node --experimental-transform-types --test OpenAIClient.test.mjs ProClient.test.mjs ServiceConfig.test.mjs speakerTranscript.test.mjs operationRecovery.test.mjs",
    "test:navigation": "node --experimental-transform-types --test ui/navigation.test.mjs ui/libraryHandoff.test.mjs",
    "test": "npm run test:transcript && npm run test:navigation && npm run test:capture && npm run test:platform",
    "test:capture": "node --test captureSession.test.mjs",
    "ios": "expo run:ios --device",
    "ios:prebuild": "expo prebuild --platform ios --no-install",
    "test:platform": "node --test platform.test.mjs",
    "ios:check": "bash scripts/check-ios-development.sh",
    "ios:testflight:build": "npx eas-cli build --platform ios --profile testflight",
    "ios:testflight:submit": "npx eas-cli submit --platform ios --profile testflight",
    "ios:device": "python3 scripts/ios_device.py",
    "test:ios-device": "python3 -m unittest discover -s scripts -p test_ios_device.py"
  },
  "dependencies": {
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "^58.0.27",
    "@noble/hashes": "2.0.1",
    "expo": "58.0.23",
    "expo-audio": "~58.0.11",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-secure-store": "~58.0.2",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  }
}
