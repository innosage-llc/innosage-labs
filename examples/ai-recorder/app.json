{
  "expo": {
    "name": "AI Recorder",
    "slug": "ai-recorder",
    "version": "0.1.1",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "co.innosage.labs.airecorder",
      "allowBackup": false,
      "versionCode": 2
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-secure-store"
    ]
  }
}
