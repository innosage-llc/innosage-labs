{
  "expo": {
    "name": "AI Recorder",
    "slug": "ai-recorder",
    "version": "0.1.9",
    "platforms": [
      "android",
      "ios"
    ],
    "android": {
      "package": "co.innosage.labs.airecorder",
      "allowBackup": false,
      "versionCode": 10
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": false,
          "microphonePermission": "Record audio clips you choose to save on this device."
        }
      ],
      "expo-secure-store"
    ],
    "ios": {
      "bundleIdentifier": "co.innosage.labs.airecorder",
      "buildNumber": "10",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Record audio clips you choose to save on this device."
      },
      "icon": "./assets/ios-icon.png"
    }
  }
}
