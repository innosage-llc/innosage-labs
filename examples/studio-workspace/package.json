{
  "name": "innosage-studio-workspace",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/material-symbols": "0.1.1",
    "@expo/metro-runtime": "58.0.17",
    "@expo/ui": "58.0.27",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "58.0.23",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "babel-preset-expo": "58.0.24",
    "tailwindcss": "3.4.17",
    "typescript": "6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "build:android": "expo prebuild --platform android --no-install && ./android/gradlew -p android app:assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "build:ios": "expo run:ios --configuration Release --no-bundler --device generic",
    "test": "node --experimental-strip-types --test src/model.test.mjs",
    "verify:snapshot": "node scripts/verify-snapshot.cjs"
  },
  "private": true
}
