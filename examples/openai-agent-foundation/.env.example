# Optional operator-only configuration. Default demo does NOT call any model.
FOUNDATION_DATA_DIR=.local-run
FOUNDATION_BIND_IP=127.0.0.1
FOUNDATION_PORT=8434
FOUNDATION_ALLOW_BILLABLE=
FOUNDATION_MAX_PROBES=1
FOUNDATION_MODEL_OUTPUT_LIMIT=550
FOUNDATION_ENABLE_SDK_COMPACTION=no
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
