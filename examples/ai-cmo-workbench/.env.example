# Copy this to .env under the isolated example; never commit .env.
# Generate a random 32+-char secret with a local secret tool.
WORKSPACE_TOKEN=REPLACE_WITH_A_RANDOM_48_PLUS_CHARACTER_SECRET
# Set to the actual private Mac LAN IP only after firewall/TLS review.
BIND_IP=127.0.0.1
TLS_CERT_PATH=
TLS_KEY_PATH=
# Mock-first: never call external OpenAI or Qwen in the default Demo.
# Mock state is separate from later live client-zero state.
AI_CMO_EXECUTION_MODE=mock
ASR_EXECUTION_MODE=mock
PRODUCT_DATA_ROOT=/data/mock
# Switch to live/local_qwen and /data only when actual credentials are ready.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# If your key belongs to a verified API organization, set this as applicable:
OPENAI_ORG_ID=
MAX_AGENT_RUNS_PER_DAY=6
MAX_MODEL_OUTPUT_TOKENS=3000
# Only use an operator-authorized, PRIVATE Edge Speech service credential.
EDGE_SPEECH_SERVICE_TOKEN=
